<Page x:Class="TestView.Index"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TestView"
      xmlns:vm="clr-namespace:TestView.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="370" d:DesignWidth="500"
      Title="Index">

    <Page.DataContext>
        <vm:AttendanceViewModel/>
    </Page.DataContext>
    <Page.Background>
        <SolidColorBrush Color="White"/>
    </Page.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="Index" Margin="5 0 0 0" FontSize="14" FontWeight="Bold"/>
        <TextBlock Grid.Row="1"
                   Text="{Binding Quantity}" Margin="5 0 0 0"/>
        <DataGrid Grid.Row="2" 
                  Margin="5" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Attendances}" FontWeight="Bold">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Header="Id" FontWeight="Normal"/>
                <DataGridTextColumn Binding="{Binding UserId}" Header="UserId" FontWeight="Normal"/>
                <DataGridTextColumn Binding="{Binding Date}" Header="Date" FontWeight="Normal"/>
                <DataGridTextColumn Binding="{Binding Time}" Header="Time" FontWeight="Normal"/>
                <DataGridTextColumn Binding="{Binding State}" Header="State" FontWeight="Normal"/>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Details" Click="Details_Click" FontWeight="Normal"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Edit" Click="Edit_Click" FontWeight="Normal"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete" Click="Delete_Click" FontWeight="Normal"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" Margin="5 5 0 0">
            <Button Content="Add" Width="40" Height="20" Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Page>
